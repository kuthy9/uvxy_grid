# ============================================================================
#  .env.example — Docker 部署需要的环境变量模板
#
#  用法:
#    1. cp .env.example .env
#    2. 填上真实值 (TWS_USERID / TWS_PASSWORD 等)
#    3. .env 永远不进 git (.gitignore 已忽略)
#
#  仅 docker compose 用. 本地直接 python main.py 时, 通过 IBKR_HOST/IBKR_PORT
#  等环境变量传入即可, 无需本文件.
# ============================================================================

# ── IBKR 账户登录 (gnzsnz/ib-gateway 容器需要) ──
TWS_USERID=
TWS_PASSWORD=

# paper | live  ——  ⚠️ live 表示真金白银, 切之前确认账户与参数
TRADING_MODE=paper

# ── IB Gateway 容器内部参数 ──
TWS_SETTINGS_PATH=/home/ibgateway/tws_settings
TWS_ACCEPT_INCOMING=accept
READ_ONLY_API=no
VNC_SERVER_PASSWORD=
TWOFA_TIMEOUT_ACTION=exit
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
EXISTING_SESSION_DETECTED_ACTION=primary
ALLOW_BLIND_TRADING=no
TIME_ZONE=America/New_York
AUTO_RESTART_TIME=11:59 PM

# ─── Telegram read-only sidecar ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_POLL_INTERVAL_SEC=5
TG_EVENT_POLL_INTERVAL_SEC=10
TG_LOG_TAIL_INTERVAL_SEC=5
TG_HEARTBEAT_STALE_MIN=30
TG_MAX_LOG_LINES=1000
IBKR_CLIENT_ID=99
