# ───────── Python ─────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ───────── 虚拟环境 ─────────
.venv/
venv/
env/
.python-version

# ───────── 系统 / 编辑器 ─────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ───────── Claude Code 项目本地 (含本地 settings / hooks) ─────────
.claude/

# ───────── 密钥与本地配置 (绝对不能进 git) ─────────
.env
.env.*
!.env.example
tws_settings/

# ───────── 运行时产物 (实盘 DB / 日志 / 周报 / 状态快照 / 缓存) ─────────
# (resilience audit writes JSON outputs under runtime/audit/; covered by this rule.)
runtime/
data_cache/
logs/

# ───────── 实验产物的临时副本 (主线产物在 runtime/experiments/ 已被忽略) ─────────
*.tmp
*.bak

# ───────── 历史数据保留, 但 parquet 缓存忽略 ─────────
data/*.parquet

# ───────── Alpaca 拉数脚本 (含 API key/secret, 不进 git) ─────────
data/qqq.py

# ───────── 数据更新 WIP (用户本地 working-set, 不进 git) ─────────
# 这些是用户在 session 开始时已经在 working tree 里的 vxx-数据-更新 WIP 文件;
# eda34dc 误 commit 过它们, 现已清理. 加这条规则避免未来 `git add .` 再次扫入.
# 若需要正式跟踪某一个, 用 `git add -f data/vxx_*.py` 显式强制添加.
data/vxx_1d.py
data/vxx_1d.csv
data/vxx_1h.py
data/vxx_1h.csv

# ───────── 项目内部文档 (本地用, 不发布到公共仓库) ─────────
CLAUDE.md
PROJECT_STATUS.md
